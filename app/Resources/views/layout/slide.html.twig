{% if showSlide is defined %}
    {% set slides = [
        {img: 'xay-dung-kim-anh-1.jpg', alt: 'Xây Dựng Kim Anh', link: null, caption: null},
        {img: 'xuan-2023-3.jpg', alt: 'Công Ty Xây Dựng Kim Anh', link: null, caption: null},
        {img: 'cong-ty-xay-dung-kim-anh.jpg', alt: 'Công ty xây dựng uy tín', link: null, caption: null},
        {img: 'xay-nha-tron-goi-tphcm.jpg', alt: 'Xây Dựng Kim Anh', link: null, caption: null},
        {img: 'banner-thi-cong-phan-tho.jpg', alt: 'Thi công xây dựng phần thô', link: null, caption: null, eager: true},
        {img: 'xay-dung-kim-anh-02.jpg', alt: 'Thương Hiệu Của Sự Bền Vững', link: null, caption: null}
    ] %}
    <div id="myCarousel" class="carousel slide" data-interval="3000" data-ride="carousel">
        <ol class="carousel-indicators">
            {% for slide in slides %}<li data-target="#myCarousel" data-slide-to="{{ loop.index0 }}"{{ loop.first ? ' class="active"' : '' }}></li>{% endfor %}
        </ol>
        <div class="carousel-inner">
            {% for slide in slides %}
                {% set basePath = '/assets/images/banner/' ~ slide.img %}
                {% set imagePath = asset(basePath) %}
                {% set imagePathFilter = asset(basePath)|imagine_filter('banner_1500_550') %}
                {% set imagePathFilterMobile = asset(basePath)|imagine_filter('banner_768_400') %}
                {% if convert_images.fileExists(imagePath) == false %}
                    {% set imgDesktop = imagePath|imagine_filter('banner_1500_550') %}
                    {% set imgMobile = imagePath|imagine_filter('banner_768_400') %}
                {% else %}
                    {% set imgDesktop = convert_images.webpConvert(imagePathFilter, '', true) %}
                    {% set imgMobile = convert_images.webpConvert(imagePathFilterMobile, '', true) %}
                {% endif %}
                {% set srcDesktop = imgDesktop ? absolute_url(imgDesktop) : absolute_url(imagePathFilter) %}
                {% set srcMobile = imgMobile ? absolute_url(imgMobile) : absolute_url(imagePathFilterMobile) %}
                <div class="item{{ loop.first ? ' active' : '' }}">
                    {% if slide.link %}<a href="{{ slide.link }}">{% endif %}
                    <picture>
                        {% if slide.eager is defined and slide.eager %}
                            <source srcset="{{ srcMobile }}" media="(max-width: 799px)">
                            <source srcset="{{ srcDesktop }}" media="(min-width: 800px)">
                            <img src="{{ srcDesktop }}" alt="{{ slide.alt }}">
                        {% else %}
                            <source data-srcset="{{ srcMobile }}" media="(max-width: 799px)">
                            <source data-srcset="{{ srcDesktop }}" media="(min-width: 800px)">
                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ srcDesktop }}" alt="{{ slide.alt }}" class="lazyload">
                        {% endif %}
                    </picture>
                    {% if slide.link %}</a>{% endif %}
                    {% if slide.caption %}
                        <div class="container"><div class="carousel-caption text-left">
                            <div class="widget-title-slide text-uppercase">Xây Dựng Kim Anh</div>
                            <p class="text-uppercase">{{ slide.caption }}</p>
                        </div></div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        <a class="left carousel-control" href="#myCarousel" role="button" data-slide="prev"><span class="glyphicon glyphicon-chevron-left" aria-hidden="true"></span><span class="sr-only">Previous</span></a>
        <a class="right carousel-control" href="#myCarousel" role="button" data-slide="next"><span class="glyphicon glyphicon-chevron-right" aria-hidden="true"></span><span class="sr-only">Next</span></a>
    </div>
{% endif %}
