<aside class="col-lg-3 d-none hidden-xs hidden-sm" id="sidebar">
    <div class="row">
        <div class="col-md-12">
            <div class="sidebar">
                {% if post is defined and post is not empty and post.getTemplate() == '1_column' %}
                    {{ render(controller(
                        'AppBundle:News:caculatorCostConstruction',
                        {'type': 'sidebar'}
                    )) }}
                {% else %}
                    {{ render(controller(
                        'AppBundle:News:caculatorCostConstruction',
                        {'type': 'sidebar'}
                    )) }}
                    {% if category is defined and category is not empty and category.getId() != 1 %}
                        {{ include('news/prices.html.twig') }}
                        {% if category is not empty and category.getShowPostRelated() %}
                            {{ render(controller(
                                'AppBundle:News:listNewsByCategorySidebar',
                                {'categoryId': category.getId(), 'title': 'Tin cùng chuyên mục', 'postNumber': 25}
                            )) }}
                        {% endif %}
                        {{ render(controller(
                            'AppBundle:News:listNewsByCategorySidebar',
                            {'categoryId': 2, 'title': 'Các mẫu nhà đẹp'}
                        )) }}
                        {{ render(controller(
                            'AppBundle:News:listNewsByCategorySidebar',
                            {'categoryId': 8, 'title': 'Dự án tiêu biểu'}
                        )) }}
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>
</aside>