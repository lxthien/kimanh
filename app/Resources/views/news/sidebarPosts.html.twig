<div class="list-group">
    <div class="list-group-item list-group-item-action active text-uppercase">{{ title }}</div>
    <div class="post-bxslider-wrapper"><div class="post-sidebar-bxslider-recent">
        {% for row in posts %}
            {% set imagePath = vich_uploader_asset(row, 'imageFile') ?: asset('assets/images/no-image.png') %}
            {% set imagePathFilter = (vich_uploader_asset(row, 'imageFile') ?: asset('assets/images/no-image.png'))|imagine_filter('news_70_65') %}
            {% set imgSrc = convert_images.fileExists(imagePath) ? convert_images.webpConvert(imagePathFilter, '', true) : imagePath|imagine_filter('news_70_65') %}
            <div class="item">
                <a href="{{ path('news_show', {'slug': row.getUrl()}) }}" class="list-group-item td-list-group-item" title="{{ row.getTitle() }}">
                    <img alt="{{ row.getTitle() }}" width="70" height="65" class="img-responsive lazyload" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ imgSrc ?: absolute_url(imagePathFilter) }}">
                    <span>{{ row.getTitle() }}</span>
                </a>
            </div>
        {% endfor %}
    </div></div>
</div>
