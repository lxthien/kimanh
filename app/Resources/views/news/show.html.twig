{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('build/css/news.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'" >
    <link href="{{ absolute_url(asset('build/css/new.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'" >
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/news.css')) }}" ></noscript>
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/new.css')) }}" ></noscript>
{% endblock %}

{% block title %}{{ (post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle())|replace({'%YEAR%': "now"|date('Y')}) }}{% endblock %}
{% block description %}{{ (post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription())|replace({'%YEAR%': "now"|date('Y')}) }}{% endblock %}
{% block keyword %}{{ post.getPageKeyword() }}{% endblock %}

{% set imagePath = (vich_uploader_asset(post, 'imageFile') ? vich_uploader_asset(post, 'imageFile') : absolute_url(asset('assets/images/no-image.png'))) %}
{% set imagePathFilter = (vich_uploader_asset(post, 'imageFile') ? vich_uploader_asset(post, 'imageFile') : absolute_url(asset('assets/images/no-image.png'))) | imagine_filter('news_share_800_420') %}
{% set userPath = asset('/assets/images/user.png') | imagine_filter('user') %}
{% set keywords = post.getPageKeyword() is not null ? post.getPageKeyword()|split(',') : null %}

{% if convert_images.fileExists(imagePath) == false %}
    {% set imagePath = imagePath | imagine_filter('news_share_800_420') %}
{% else %}
    {% set imagePath = convert_images.webpConvert(imagePathFilter, '', true) %}
{% endif %}

{% block structuredOpenGraph %}
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ (post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle())|replace({'%YEAR%': "now"|date('Y')}) }}" />
    <meta property="og:description" content="{{ (post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription())|replace({'%YEAR%': "now"|date('Y')}) }}" />
    <meta property="article:author" content="{{ post.getAuthor().getName() }}" />
	<meta property="article:published_time" content="{{ post.getCreatedAt()|date("Y-m-d h:m:s") ~ "+07:00" }}" />
	<meta property="article:modified_time" content="{{ post.getUpdatedAt()|date("Y-m-d h:m:s") ~ "+07:00" }}" />
    <meta property="og:image" content="{{ absolute_url(imagePathFilter) }}" />
    <meta property="og:image:alt" content="{{ post.getTitle() }}" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
{% endblock %}

{% block twitterImage %}
    <meta property="twitter:image" content="{{ absolute_url(imagePathFilter) }}" />
{% endblock %}

{% block structuredReview %}
    {% if ratingCount > 0 %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org/",
        "@type": "CreativeWorkSeries",
        "name": "{{ post.getTitle() }}",
        "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "{{ rating }}",
            "ratingCount": "{{ ratingCount }}",
            "bestRating" : "5",
            "worstRating": "1"
        }
    }
    </script>
    {% endif %}
{% endblock %}

{% block robots %}
    {% if urlParameters != NULL %}
        <meta name="robots" content="follow, noindex" />
    {% else %}
        {% if post.getRobots() != NULL %}
        <meta name="robots" content="{{ post.getRobots() }}" />
        {% else %}
        <meta name="robots" content="index, follow" />
        {% endif %}
    {% endif %}
{% endblock %}

{% block contactHotline %}
    {% if post.getContactHotline() is empty %}
        <div class="hotline">
            <div class="inner">
                <a href="tel:0974776305"><div class="phonering-alo-ph-img-circle"></div>0974.776.305</a>
            </div>
        </div>
    {% else %}
        {{ post.getContactHotline()|raw }}
    {% endif %}
{% endblock %}

{% block blogPosting %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org/",
        "@type": "WebPage",
        "@id": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}#webpage",
        "url": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}",
        "name": "{{ (post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle())|replace({'%YEAR%': "now"|date('Y')}) }}",
        "datePublished": "{{ post.getCreatedAt()|date('Y-m-d h:m:s') ~ '+07:00' }}",
        "dateModified": "{{ post.getUpdatedAt()|date('Y-m-d h:m:s') ~ '+07:00' }}",
        "isPartOf": {
            "@id": "{{ absolute_url(path('homepage')) }}#website"
        },
        "primaryImageOfPage": {
            "@id": "{{ absolute_url(imagePathFilter) }}"
        },
        "description": "{{ (post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription())|replace({'%YEAR%': "now"|date('Y')}) }}",
        "breadcrumb": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}#breadcrumb",
        "inLanguage": "vi-VN"
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org/",
        "@type": "BlogPosting",
        "@id": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}#BlogPosting",
        "mainEntityOfPage": {
            "@id": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}#webpage"
        },
        "isFamilyFriendly":true,
        "isAccessibleForFree":true,
        "headline": "{{ post.getTitle() }}",
        "name": "{{ (post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle())|replace({'%YEAR%': "now"|date('Y')}) }}",
        "description": "{{ (post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription())|replace({'%YEAR%': "now"|date('Y')}) }}",
        "datePublished": "{{ post.getCreatedAt()|date('Y-m-d h:m:s') ~ '+07:00' }}",
        "dateModified": "{{ post.getUpdatedAt()|date('Y-m-d h:m:s') ~ '+07:00' }}",
        "articleSection": "{{ category.getName() }}",
        "accessMode":[
            "textual"
        ],
        "author": {
            "@type": "Person",
            "@id": "{{ absolute_url(path('author', {'slug': 'kimanh' })) }}#Person",
            "name": "Nguyễn Duy Tuấn",
            "url": "{{ absolute_url(path('author', {'slug': 'kimanh' })) }}",
            "image": {
                "@type": "ImageObject",
                "@id": "{{ absolute_url(convert_images.webpConvert(userPath, '', true)) }}",
                "url": "{{ absolute_url(convert_images.webpConvert(userPath, '', true)) }}",
                "height": "65",
                "width": "65"
            }
        },
        "publisher": {
            "@type": "Organization",
            "@id": "{{ absolute_url(path('homepage')) }}#organization"
        },
        "image": {
            "@type": "ImageObject",
            "@id": "{{ absolute_url(imagePathFilter) }}#image",
            "url": "{{ absolute_url(imagePathFilter) }}",
            "height": "800",
            "width": "420"
        },
        "url": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}",
        "wordCount": "{{ contentsLazy|replace({'50I Trần Thị Bảy, KP 3, Phường Hiệp Thành, Quận 12, TP Hồ Chí Minh':'C40 - KDC Hiệp Thành - Nguyễn Thị Búp, Phường Hiệp Thành, Quận 12, TP Hồ Chí Minh', '088.609.4455':'0966.289.559'})|raw|length }}",
        "acquireLicensePage": "{{ absolute_url(path('news_show', {'slug': 'chinh-sach-bao-mat-thong-tin' })) }}",
        "copyrightHolder": {
            "@id": "{{ absolute_url(path('homepage')) }}#organization"
        },
        "accountablePerson": {
            "@id": "{{ absolute_url(path('author', {'slug': 'kimanh' })) }}#Person"
        },
        "creator": {
            "@id": "{{ absolute_url(path('author', {'slug': 'kimanh' })) }}#Person"
        },
        "sourceOrganization": {
            "@id": "{{ absolute_url(path('homepage')) }}#organization"
        },
        "inLanguage": "vi-VN",
        "commentCount": "{{ comments|length }}",
        "isPartOf": {
            "@id": "{{ absolute_url(path('news_show', {'slug': post.getUrl() })) }}#webpage"
        }{% if keywords is not null %},
        "keywords": [
            {% for keyword in keywords %}
            "{{ keyword|trim }}"{% if loop.last == false %},{% endif %}
            {% endfor %}
        ]
        {% endif %}
    }
    </script>
{% endblock %}

{% block body %}
    <div class="container wrapper-container page-detail">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-9 page-detail-container">
                {{ include('news/components/breadcrumbs.html.twig') }}

                <article id="post-{{ post.getId() }}" class="news">
                    <h1 class="entry-title block-title">{{ post.getTitle() }}</h1>
                    <p class="post-modified-info">Cập nhật ngày: {{ post.getUpdatedAt()|date('d/m/Y') }} bởi <a href="{{ path('news_show', {'slug': 'nguyenduytuan' }) }}" target="_blank" class="last-modified-author">Nguyễn Duy Tuấn</a></p>
                    <div class="news-container">
                        {{ contentsLazy|replace({'50I Trần Thị Bảy, KP 3, Phường Hiệp Thành, Quận 12, TP Hồ Chí Minh':'C40 - KDC Hiệp Thành - Nguyễn Thị Búp, Phường Hiệp Thành, Quận 12, TP Hồ Chí Minh', '088.609.4455':'0966.289.559', 'www.xaydungkimanh.com':'xaydungkimanh.com', '%YEAR%': "now"|date('Y') })|raw }}
                    </div>

                    {# Rating and Share #}
                    <div class="rating-share-container">
                        {{ include('news/rating/rating.html.twig') }}
                    </div>

                    {# Author #}
                    {{ include('news/components/author.html.twig') }}
                    
                    {# List comments #}
                    {{ include('news/comments/list.html.twig') }}
                    
                    {# Render form comment #}
                    {{ include('news/comments/form.html.twig') }}
                </article>
            </div>

            {{ include('layout/sidebar.html.twig') }}

            {# <div class="col-12 col-md-12 col-lg-12">
                {{ include('news/components/related.html.twig') }}
            </div> #}
        </div>
    </div>
{% endblock %}