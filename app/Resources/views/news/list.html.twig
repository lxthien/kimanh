{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('build/css/list.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/list.css')) }}"></noscript>
{% endblock %}

{% set pageTitle = category.getPageTitle() ?: category.getName() %}
{% set pageDesc = category.getPageDescription() ?: category.getName() %}

{% block title %}{{ pageTitle }}{% endblock %}
{% block description %}{{ pageDesc }}{% endblock %}
{% block keyword %}{{ category.getPageKeyword() }}{% endblock %}

{% block structuredOpenGraph %}
    {% if not category.getIsPage() %}
        <meta property="og:type" content="object">
        <meta property="og:title" content="{{ pageTitle }}">
        <meta property="og:description" content="{{ category.getPageDescription() }}">
        {% if pagination.pageCount > 1 %}
            {% if pagination.currentPageNumber == 1 %}
                <link rel="next" href="{{ baseUrl ~ '/' ~ 2 }}">
            {% elseif pagination.currentPageNumber < pagination.pageCount %}
                <link rel="prev" href="{{ pagination.currentPageNumber == 2 ? baseUrl : baseUrl ~ '/' ~ (pagination.currentPageNumber - 1) }}">
                <link rel="next" href="{{ baseUrl ~ '/' ~ (pagination.currentPageNumber + 1) }}">
            {% else %}
                <link rel="prev" href="{{ pagination.currentPageNumber == 2 ? baseUrl : baseUrl ~ '/' ~ (pagination.currentPageNumber - 1) }}">
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}

{% block blogPosting %}{% if category.getSchemaMarkup() %}{{ category.getSchemaMarkup()|raw }}{% endif %}{% endblock %}

{% block robots %}
<meta name="robots" content="{{ category.getRobots() ?: 'follow, noindex' }}">
{% endblock %}

{% block canonical %}
    <meta name="DC.identifier" content="{{ baseUrl }}">
    <link rel="canonical" href="{{ baseUrl }}">
{% endblock %}

{% block body %}
    {{ include('news/components/breadcrumbs.html.twig', {type: 'category', title: category.getTitleLandingPage() ?: category.getName(), description: category.getDescription()}) }}
    <div class="container wrapper-container">
        <div class="row category-list-items">
            <div class="col-lg-12">
                {% if category.getContent() %}
                    <div class="category-content">{{ category.getContent()|raw }}</div>
                    <div class="list-news-items list-news-items-landing">
                        <h2>Có thể bạn quan tâm</h2>
                        <div class="row">{% for row in pagination %}{{ include('news/components/itemsGrid.html.twig', {row: row, target: '_blank', rel: 'noopener'}, with_context = false) }}{% endfor %}</div>
                    </div>
                {% elseif pagination|length > 0 %}
                    {% if get_setting('isShowSortOnCategory') %}{{ include('news/components/sort.html.twig') }}{% endif %}
                    <div class="list-news-items"><div class="row">{% for row in pagination %}{{ include('news/components/itemsGrid.html.twig') }}{% endfor %}</div></div>
                    {{ include('news/components/pagination.html.twig') }}
                {% else %}
                    {{ include('news/components/noRecord.html.twig') }}
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
