{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_dashboard_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <!-- Statistics Widgets Row -->
            <div class="row">
                <!-- Total Posts Widget -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-1">
                        <div class="card-body pb-0">
                            <div class="stat-widget-content">
                                <h4 class="mb-0">
                                    <span class="count">{{ totalPosts }}</span>
                                </h4>
                                <p class="text-light">{{ 'Bài viết'|trans }}</p>
                            </div>
                            <div class="icon-big text-right">
                                <i class="fa fa-newspaper-o"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total Comments Widget -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-2">
                        <div class="card-body pb-0">
                            <div class="stat-widget-content">
                                <h4 class="mb-0">
                                    <span class="count">{{ totalComments }}</span>
                                </h4>
                                <p class="text-light">{{ 'Bình luận'|trans }}</p>
                            </div>
                            <div class="icon-big text-right">
                                <i class="fa fa-comments"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total Views Widget -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-3">
                        <div class="card-body pb-0">
                            <div class="stat-widget-content">
                                <h4 class="mb-0">
                                    <span class="count">{{ (totalViews / 1000)|round(1) }}{{ totalViews >= 1000 ? 'K' : '' }}</span>
                                </h4>
                                <p class="text-light">{{ 'Lượt xem'|trans }}</p>
                            </div>
                            <div class="icon-big text-right">
                                <i class="fa fa-eye"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Total Users Widget -->
                <div class="col-sm-6 col-lg-3">
                    <div class="card text-white bg-flat-color-4">
                        <div class="card-body pb-0">
                            <div class="stat-widget-content">
                                <h4 class="mb-0">
                                    <span class="count">{{ totalUsers }}</span>
                                </h4>
                                <p class="text-light">{{ 'Người dùng'|trans }}</p>
                            </div>
                            <div class="icon-big text-right">
                                <i class="fa fa-users"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- View Trends Chart -->
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'Xu hướng lượt xem (30 ngày)' }}</strong>
                        </div>
                        <div class="card-body">
                            <div class="chart-wrapper">
                                <canvas id="viewTrendsChart" style="height: 300px;"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comment Status & Recent Activity Row -->
            <div class="row">
                <!-- Comment Status -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'Trạng thái bình luận' }}</strong>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="stat-widget-one">
                                        <div class="stat-icon dib">
                                            <i class="ti-check text-success border-success"></i>
                                        </div>
                                        <div class="stat-content dib">
                                            <div class="stat-text">{{ 'Đã duyệt' }}</div>
                                            <div class="stat-digit">{{ approvedComments }}</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="stat-widget-one">
                                        <div class="stat-icon dib">
                                            <i class="ti-time text-warning border-warning"></i>
                                        </div>
                                        <div class="stat-content dib">
                                            <div class="stat-text">{{ 'Đang chờ' }}</div>
                                            <div class="stat-digit">{{ pendingComments }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <table class="table thead-light table-sm mt-3">
                                <thead>
                                    <tr>
                                        <th>{{ 'Người dùng'|trans }}</th>
                                        <th>{{ 'Trạng thái' }}</th>
                                        <th>{{ 'Ngày' }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for comment in recentComments|slice(0, 5) %}
                                    <tr>
                                        <td>{{ comment.author }}</td>
                                        <td>
                                            {% if comment.approved %}
                                                <span class="badge badge-success">{{ 'Duyệt' }}</span>
                                            {% else %}
                                                <span class="badge badge-warning">{{ 'Chờ' }}</span>
                                            {% endif %}
                                        </td>
                                        <td><small>{{ comment.createdAt|localizeddate('short', 'short', null, 'Asia/Ho_Chi_Minh', 'd/m H:i') }}</small></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Top Posts by Views -->
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'Bài viết xem nhiều nhất' }}</strong>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead class="thead-light">
                                    <tr>
                                        <th>{{ 'label.title'|trans }}</th>
                                        <th>{{ 'Lượt xem' }}</th>
                                        <th>%</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set maxViews = topPosts|first.viewCounts %}
                                    {% for post in topPosts %}
                                    <tr>
                                        <td>
                                            <a href="{{ path(post.postType == 'page' ? 'admin_page_edit' : 'admin_news_edit', {id: post.id}) }}" title="Edit">
                                                {{ post.title|slice(0, 30) }}{{ post.title|length > 30 ? '...' : '' }}
                                            </a>
                                        </td>
                                        <td><strong>{{ post.viewCounts }}</strong></td>
                                        <td>
                                            <div class="progress progress-xs">
                                                <div class="progress-bar bg-success" role="progressbar" style="width: {{ maxViews > 0 ? (post.viewCounts / maxViews * 100)|round : 0 }}%"></div>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Posts -->
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">{{ 'Bài viết mới (7 ngày)' }}</strong>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-striped">
                                <thead class="thead-light">
                                    <tr>
                                        <th>{{ 'label.title'|trans }}</th>
                                        <th>{{ 'Ngày tạo' }}</th>
                                        <th>{{ 'Lượt xem' }}</th>
                                        <th>{{ 'Action' }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for post in recentPosts %}
                                    <tr>
                                        <td>
                                            <a href="{{ path(post.postType == 'page' ? 'admin_page_edit' : 'admin_news_edit', {id: post.id}) }}">
                                                {{ post.title|slice(0, 50) }}{{ post.title|length > 50 ? '...' : '' }}
                                            </a>
                                        </td>
                                        <td><small>{{ post.createdAt|localizeddate('short', 'short', null, 'Asia/Ho_Chi_Minh', 'd/m/Y H:i') }}</small></td>
                                        <td><span class="badge badge-info">{{ post.viewCounts }}</span></td>
                                        <td>
                                            <a href="{{ path(post.postType == 'page' ? 'admin_page_edit' : 'admin_news_edit', {id: post.id}) }}" class="btn btn-sm btn-primary">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">{{ 'Không có dữ liệu' }}</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // View Trends Chart
        var ctx = document.getElementById('viewTrendsChart');
        if (ctx) {
            var viewTrendsData = {{ viewTrends|json_encode|raw }};
            var dates = Object.keys(viewTrendsData);
            var views = Object.values(viewTrendsData);
            
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: dates,
                    datasets: [{
                        label: 'Lượt xem',
                        data: views,
                        borderColor: '#4CAF50',
                        backgroundColor: 'rgba(76, 175, 80, 0.1)',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#4CAF50',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>

    <style>
        .stat-widget-content {
            min-height: 60px;
        }
        .icon-big {
            font-size: 40px;
            opacity: 0.3;
        }
        .progress-xs {
            height: 4px;
        }
    </style>
{% endblock %}
