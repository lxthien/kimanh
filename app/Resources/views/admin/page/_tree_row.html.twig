<tr>
    <td>
        <div class="images-container">
            <img src="{{ (vich_uploader_asset(page, 'imageFile') ? vich_uploader_asset(page, 'imageFile') : asset('assets/images/no-image.png')) | imagine_filter('admin_thumb') }}" alt="{{ page.getTitle() }}" />
        </div>
    </td>
    <td>
        <span style="margin-left: {{ level * 30 }}px;">
            {% if page.getChildren().count() > 0 %}
                <i class="fa fa-folder text-primary"></i>
            {% else %}
                <i class="fa fa-file-text text-gray"></i>
            {% endif %}
            <a class="btn-link" href="{{ path('admin_page_edit', {id: page.id}) }}">{{ page.getTitle() }}</a>
        </span>
    </td>
    <td>{{ page.getParent() ? page.getParent().getTitle() : '-' }}</td>
    <td>{{ page.getCreatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
    <td>{{ page.getUpdatedAt() | localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
    <td>
        <div class="item-actions">
            <a href="{{ path('admin_page_edit', {id: page.id}) }}" class="btn-sm">
                <i class="fa fa-edit" aria-hidden="true"></i>
            </a>
            
            {{ include('admin/page/_delete_form.html.twig', {news: page}, with_context = false) }}
        </div>
    </td>
</tr>

{% for child in page.getChildren() %}
    {{ include('admin/page/_tree_row.html.twig', {'page': child, 'level': level + 1}, with_context = false) }}
{% endfor %}
