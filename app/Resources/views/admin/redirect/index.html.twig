{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_redirect_index' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Quản lý Redirects</strong>
                            <a href="{{ path('admin_redirect_new') }}" class="btn btn-primary btn-sm pull-right">
                                <i class="fa fa-plus"></i> {{ 'menu.add_new'|trans }}
                            </a>
                        </div>
                        <div class="card-body">
                             <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Old URL</th>
                                        <th>New URL</th>
                                        <th>Type</th>
                                        <th>Hits</th>
                                        <th>Last Accessed</th>
                                        <th>Status</th>
                                        <th>{{ 'label.actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in pagination %}
                                    <tr>
                                        <td><code>{{ row.oldUrl }}</code></td>
                                        <td><code>{{ row.newUrl }}</code></td>
                                        <td>
                                            {% if row.statusCode == 301 %}
                                                <span class="badge badge-info">301 - Permanent</span>
                                            {% elseif row.statusCode == 302 %}
                                                <span class="badge badge-warning">302 - Temporary</span>
                                            {% elseif row.statusCode == 307 %}
                                                <span class="badge badge-warning">307 - Temp (Method)</span>
                                            {% elseif row.statusCode == 308 %}
                                                <span class="badge badge-info">308 - Perm (Method)</span>
                                            {% else %}
                                                <span class="badge badge-dark">{{ row.statusCode }}</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge badge-light"><strong>{{ row.hits }}</strong> hits</span>
                                        </td>
                                        <td>
                                            {% if row.lastAccessedAt %}
                                                {{ row.lastAccessedAt|date('Y-m-d H:i:s') }}
                                            {% else %}
                                                <span class="text-muted">Never</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if row.enable %}
                                                <span class="badge badge-success">Active</span>
                                            {% else %}
                                                <span class="badge badge-secondary">Disabled</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="item-actions d-flex">
                                                <a href="{{ path('admin_redirect_edit', {id: row.id}) }}" class="btn btn-sm btn-info mr-1">
                                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                                </a>

                                                {{ include('admin/redirect/_delete_form.html.twig', {object: row}, with_context = false) }}
                                            </div>
                                        </td>
                                    </tr>
                                    {% else %}
                                    <tr>
                                        <td colspan="7">Không có dữ liệu</td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                            
                            <div class="navigation mt-3">
                                {{ knp_pagination_render(pagination) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- .animated -->
    </div>
{% endblock %}
