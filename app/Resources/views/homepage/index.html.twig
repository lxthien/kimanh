{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('build/css/homepage.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'" >
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/homepage.css')) }}" ></noscript>
{% endblock %}

{% block structuredOpenGraph %}
    <meta property="og:image" content="{{ absolute_url(asset('assets/images/banner/xay-dung-kim-anh-5.jpg')) }}" />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="420" />
{% endblock %}

{% block localBusiness %}
    {{ get_setting('googleAnalytic')|raw }}
{% endblock %}

{% block body %}
    <div class="wrapper-container">
        <section class="slogin">
            <div class="container slogin-title">
                <div class="row">
                    <div class="col-md-10">
                        <div class="slogin-wrapper">Bạn đang muốn thi công dự án xây dựng? Hãy liên hệ ngay đến <h1>Xây Dựng Kim Anh</h1> để được tư vấn miễn phí!</div>
                    </div>
                    <div class="col-md-2 text-right"><a href="tel:0974776305"><i class="fas fa-mobile-alt"></i> 0974776305</a></div>
                </div>
            </div>
        </section>

        <section class="prices-table">
            <div class="container">
                <div class="row marketing">
                    {% for priceOnHomepage in blockPricesOnHomepage %}
                        {% set imagePath = (vich_uploader_asset(priceOnHomepage, 'imageFile') ? vich_uploader_asset(priceOnHomepage, 'imageFile') : asset('assets/images/no-image.png')) %}
                        {% set imagePathFilter = (vich_uploader_asset(priceOnHomepage, 'imageFile') ? vich_uploader_asset(priceOnHomepage, 'imageFile') : asset('assets/images/no-image.png')) | imagine_filter('news_218_218') %}
                        {% if convert_images.fileExists(imagePath) == false %}
                            {% set imagePath = imagePath | imagine_filter('news_218_218') %}
                        {% else %}
                            {% set imagePath = convert_images.webpConvert(imagePathFilter, '', true) %}
                        {% endif %}
                        <div class="col-md-3 col-sm-3">
                            <div class="intro">
                                <a href="{{ path('news_show', {'slug': priceOnHomepage.getUrl() }) }}" class="img">
                                    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="{{ priceOnHomepage.getTitle() }}" class="img-responsive lazyload" data-src="{{ imagePath != false ? absolute_url(imagePath) : absolute_url(imagePathFilter) }}" width="218" height="218">
                                </a>
                                <div class="text">
                                    <a href="{{ path('news_show', {'slug': priceOnHomepage.getUrl() }) }}">{{ priceOnHomepage.getTitle() }}</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <section class="why-choose-us">
            <div class="container">
                <h2 class="text-center text-uppercase why-choose-us-title">Tại sao chọn chúng tôi</h2>
                <div class="row">
                    <div class="col-md-4 col-sm-6">
                        <div class="media">
                            <span class="media-left"><i class="fa fa-globe"></i></span>
                            <div class="media-body">
                                <b class="media-heading text-uppercase">Báo giá miễn phí, tận nơi</b>
                                <p>Báo giá xây dựng nhà phố, biệt thự, sửa chữa nhà miễn phí, nhanh chóng, tận nơi, làm việc 24/7</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="media">
                            <span class="media-left"><i class="fa fa-balance-scale"></i></span>
                            <div class="media-body">
                                <b class="media-heading text-uppercase">Giá hợp lý, cạnh tranh</b>
                                <p>Bảng báo giá xây dựng nhà, sửa chữa nhà của chúng tôi hợp lý, rõ ràng từng vấn đề, cạnh tranh</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="media">
                            <span class="media-left"><i class="fas fa-users"></i></span>
                            <div class="media-body">
                                <b class="media-heading text-uppercase">Đội ngũ chuyên nghiệp</b>
                                <p>Bạn sẽ được làm việc cùng đội ngũ kiến trúc sư, kĩ sư, tổ thợ chuyên nghiệp, nhiều kinh nghiệm</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="media">
                            <span class="media-left"><i class="fas fa-gem"></i></span>
                            <div class="media-body">
                                <b class="media-heading text-uppercase">Cam kết bảo hành</b>
                                <p>Chúng tôi luôn cam kết bảo hành công trình thi công lâu dài, đồng hành cùng quý khách hàng</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="media">
                            <span class="media-left"><i class="fas fa-lightbulb"></i></span>
                            <div class="media-body">
                                <b class="media-heading text-uppercase">Sáng tạo trong thiết kế</b>
                                <p>Kỹ sư thiết kế về kiến trúc và nội thất có kinh nghiệm sẽ đưa đến những ý tưởng sáng tạo cho ngôi nhà của bạn</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-sm-6">
                        <div class="media">
                            <span class="media-left"><i class="fa fa-bullhorn"></i></span>
                            <div class="media-body">
                                <b class="media-heading text-uppercase">Không phát sinh phí</b>
                                <p>Chúng tôi cam kết đến toàn thể quý khách hàng không phát sinh phí trong quá trình xây dựng</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {% for blockOnHomepage in blocksOnHomepage %}
            {% if blockOnHomepage.category.getParentcat() == 'root' %}
                {% set linkCat = path('news_category', {'level1': blockOnHomepage.category.getUrl() }) %}
            {% else %}
                {% set linkCat = path('list_category', {'level1': blockOnHomepage.category.getParentcat().getUrl(), 'level2': blockOnHomepage.category.getUrl() }) %}
            {% endif %}
            <section class="services-block">
                <div class="container">
                    <div class="title-list-news-items">
                        <div class="text-uppercase p-title-news-items">
                            <img alt="{{ blockOnHomepage.category.getName() }}" src="{{ asset('assets/images/icon-logo.png') }}" width="35" height="25">
                            <p class="p-title-news-items-lvht">{{ blockOnHomepage.title }}</p>
                            <i class="fa fa-angle-right"></i>
                            <h2><a href="{{ linkCat }}">{{ blockOnHomepage.category.getName() }}</a></h2>
                        </div>
                        <span class="block-underline"></span>
                        <p class="p-title-news-items-description">{{ blockOnHomepage.description }}</p>
                        {% if blockOnHomepage.listSubTabs|length > 0 %}
                            <ul class="nav nav-tabs nav-tabs-sub-cat" role="tablist">
                                {% for listSubTab in blockOnHomepage.listSubTabs %}
                                    <li role="presentation"{{ loop.first ? ' class="active"' : '' }}><a href="#tab_{{ listSubTab.subCategory.getId() }}" role="tab" data-toggle="tab">{{ listSubTab.subCategory.getName() }}</a></li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                    {% if blockOnHomepage.listSubTabs|length > 0 %}
                        <div class="tab-content">
                            {% for listSubTab in blockOnHomepage.listSubTabs %}
                                <div role="tabpanel" class="tab-pane{{ loop.first ? ' active' : '' }}" id="tab_{{ listSubTab.subCategory.getId() }}">
                                    <div class="list-news-items"><div class="row">
                                        {% for row in listSubTab.posts %}{% include 'news/components/itemsGridHomepage.html.twig' with {'category': listSubTab.subCategory} %}{% endfor %}
                                    </div></div>
                                    <div class="view-all-category text-center"><a href="{{ path('list_category', {'level1': blockOnHomepage.category.getUrl(), 'level2': listSubTab.subCategory.getUrl() }) }}">{{ listSubTab.subCategory.getName() }}</a></div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="list-news-items"><div class="row">
                            {% for row in blockOnHomepage.posts %}{% include 'news/components/itemsGridHomepage.html.twig' with {'category': blockOnHomepage.category} %}{% endfor %}
                        </div></div>
                        <div class="view-all-category text-center"><a href="{{ linkCat }}">{{ blockOnHomepage.category.getName() }}</a></div>
                    {% endif %}
                </div>
            </section>
        {% endfor %}

        <section class="y-kien-khach-hang">
            <div class="container">
                <h2 class="cat-widget-title text-center text-uppercase">Khách hàng đánh giá</h2>
                <div class="row media-wrapper">
                    <div class="col-sm-3">
                        <div class="youtube-video-place embed-responsive embed-responsive-4by3" data-yt-url="https://www.youtube.com/embed/76AB9uOFBos?rel=0&showinfo=0&autoplay=1">
                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ asset(convert_images.webpConvert2(asset('/assets/images/yt-1.jpg'), '')) }}" class="play-youtube-video lazyload" alt="Khách hàng chia sẻ về Xây Dựng Kim Anh" width="277" height="208">
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="youtube-video-place embed-responsive embed-responsive-4by3" data-yt-url="https://www.youtube.com/embed/qZHPIqGX7pA?rel=0&showinfo=0&autoplay=1">
                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ asset(convert_images.webpConvert2(asset('/assets/images/yt-2.jpg'), '')) }}" class="play-youtube-video lazyload" alt="Ý kiến khách hàng về Xây Dựng Kim Anh" width="282" height="212">
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="youtube-video-place embed-responsive embed-responsive-4by3" data-yt-url="https://www.youtube.com/embed/CsMoN-G_QK8?rel=0&showinfo=0&autoplay=1">
                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ asset(convert_images.webpConvert2(asset('/assets/images/yt-3.jpg'), '')) }}" class="play-youtube-video lazyload" alt="Xây Nhà Quận Bình Tân - Uy Tín" width="277" height="208">
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="youtube-video-place embed-responsive embed-responsive-4by3" data-yt-url="https://www.youtube.com/embed/Jw70fD5eZp4?rel=0&showinfo=0&autoplay=1">
                            <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="{{ asset(convert_images.webpConvert2(asset('/assets/images/yt-4.jpg'), '')) }}" class="play-youtube-video lazyload" alt="Ý kiến khách hàng về Kim Anh" width="277" height="208">
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
{% endblock %}