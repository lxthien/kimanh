{% extends 'layout.html.twig' %}

{% block stylesheets %}
    <link href="{{ absolute_url(asset('build/css/news.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'" >
    <link href="{{ absolute_url(asset('build/css/new.css')) }}" rel="preload stylesheet" as="style" onload="this.rel='stylesheet'" >
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/news.css')) }}" ></noscript>
    <noscript><link rel="stylesheet" href="{{ absolute_url(asset('build/css/new.css')) }}" ></noscript>
{% endblock %}

{% block title %}{{ post.getPageTitle() is not null ? post.getPageTitle() : post.getTitle() }}{% endblock %}
{% block description %}{{ post.getPageDescription() is not null ? post.getPageDescription() : post.getDescription() }}{% endblock %}
{% block keyword %}{{ post.getPageKeyword() }}{% endblock %}

{% block body %}
    <div class="container wrapper-container page-detail costs">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-9 page-detail-container">
                {{ include('news/components/breadcrumbs.html.twig') }}

                <div class="news-container news">
                    <h1 class="entry-title block-title">Dự toán chi phí xây dựng</h1>
                    {{ post.getContents()|raw }}
                </div>

                <hr>
                
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
                
                {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.type) }}
                            {{ form_errors(form.type) }}
                            {{ form_widget(form.type) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.method) }}
                            {{ form_errors(form.method) }}
                            {{ form_widget(form.method) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.wide) }}
                            {{ form_errors(form.wide) }}
                            {{ form_widget(form.wide) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.long) }}
                            {{ form_errors(form.long) }}
                            {{ form_widget(form.long) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            {{ form_label(form.floor) }}
                            {{ form_errors(form.floor) }}
                            {{ form_widget(form.floor) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            {{ form_label(form.mong) }}
                            {{ form_errors(form.mong) }}
                            {{ form_widget(form.mong) }}
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            {{ form_label(form.mai) }}
                            {{ form_errors(form.mai) }}
                            {{ form_widget(form.mai) }}
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            {{ form_widget(form.reset) }}
                            {{ form_widget(form.caculator) }}
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}

                {% if costs is not null %}
                <div class="row costs-result">
                    <div class="col-md-12">
                        <h2 class="costs-title">Kết quả tính diện tích và chi phí thi công xây dựng nhà</h2>
                        <table>
                            <thead>
                                <tr>
                                    <th colspan="4" class="text-uppercase">{{ costs.title }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <th>STT</th>
                                    <th>Loại</th>
                                    <th>Diện tích (m<sup>2</sup>)</th>
                                    <th>Thành tiền</th>
                                </tr>
                                <tr>
                                    <td>1</td>
                                    <td>{{ costs.titleMong }}</td>
                                    <td>{{ costs.areaMong }} (m<sup>2</sup>)</td>
                                    <td>Thành tiền</td>
                                </tr>
                                <tr>
                                    <td>2</td>
                                    <td>{{ costs.titleMai }}</td>
                                    <td>{{ costs.areaMai }} (m<sup>2</sup>)</td>
                                    <td>Thành tiền</td>
                                </tr>
                                {% if costs.floor > 0 %}
                                {% for i in range(1, costs.floor - 1) %}
                                <tr>
                                    <td>2</td>
                                    <td>Tầng {{ i }}</td>
                                    <td>{{ costs.area }} (m<sup>2</sup>)</td>
                                    <td>Thành tiền</td>
                                </tr>
                                {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                        <p><span>Diện tích tầng trệt:</span> {{ costs.area }} m<sup>2</sup></p>
                        <p><span>Tổng diện tích:</span> {{ costs.areaTotal }} m<sup>2</sup></p>
                        <p><span>{{ costs.title }}:</span> {{ costs.cost|number_format(0, '.', ',') }} <sup>đ</sup></p>
                        <p><span>Chi phí dự kiến:</span> {{ costs.costTotal|number_format(0, '.', ',') }} <sup>đ</sup></p>
                        <p>Liên hệ hotline: <a href="tel:0982969379">0982.96.93.79</a> A Minh để nhận tư vấn, <a href="{{ path('news_show', {'slug': 'bao-gia-xay-nha-tron-goi' }) }}">báo giá xây nhà</a> miễn phí</p>
                        <p><strong>Email:</strong> <a href="mailto:xaydungkimanh@gmail.com">xaydungkimanh@gmail.com</a></p>
                        <p><i><strong>Lưu ý: {{ costs.note|raw }}</strong></i></p>
                    </div>
                </div>
                {% endif %}
            </div>

            {# Side bar #}
            {{ include('layout/sidebar.html.twig') }}
        </div>

        {{ render(controller(
            'AppBundle:News:listNewsByCategory', { 'categoryId': 2 }
        )) }}
    </div>
{% endblock %}