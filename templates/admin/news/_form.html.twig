{{ form_start(form, {attr: attr|default({})}) }}
    {% for child in form %}
        {% if child.vars.name not in ['save', 'saveAndCreateNew'] %}
            {% if child.vars.name == 'contents' %}
                <div class="cms-block-editor-layout">
                    {{ include('admin/content_block/_toolbar.html.twig', {
                        target_editor: child.vars.id,
                        current_id: form.vars.value.id|default(0),
                    }, with_context = false) }}
                    <div class="cms-block-editor-layout__field">
                        {{ form_row(child) }}
                    </div>
                </div>
            {% else %}
                {{ form_row(child) }}
            {% endif %}
        {% endif %}
    {% endfor %}

    {% if form.save is defined %}
        {{ form_widget(form.save, {label: button_label|default('label.create_post'|trans), attr: {class: button_css|default("btn btn-primary")}}) }}
    {% else %}
        <button type="submit" class="{{ button_css|default("btn btn-primary") }}">
            <i class="fa fa-save" aria-hidden="true"></i> {{ button_label|default('label.create_post'|trans) }}
        </button>
    {% endif %}

    {% if form.saveAndCreateNew is defined %}
        {{ form_widget(form.saveAndCreateNew, {label: 'label.save_and_create_new', attr: {class: button_css|default("btn btn-primary")}}) }}
    {% endif %}

    {{ form_rest(form) }}

    {% if include_back_to_home_link|default(false) %}
        <a href="{{ path('admin_news_index') }}" class="btn btn-link">
            <i class="fa fa-list-alt" aria-hidden="true"></i> {{ 'action.back_to_list'|trans }}
        </a>
    {% endif %}
{{ form_end(form) }}
