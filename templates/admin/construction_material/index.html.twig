{% extends 'admin/layout.html.twig' %}

{% block main %}
    <div class="content mt-3">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-3">
                    <div class="card add">
                        <div class="card-body">
                            <div class="stat-widget-one">
                                <a href="{{ path('admin_construction_material_new') }}">
                                    <div class="stat-icon dib">
                                        <i class="ti-plus text-success border-success"></i>
                                    </div>
                                    <div class="stat-content dib">
                                        <div class="stat-text text-success">Thêm vật tư</div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Bảng giá vật tư thi công</strong>
                        </div>
                        <div class="card-body">
                            <table id="bootstrap-data-table" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Tên vật tư</th>
                                        <th>Nhóm</th>
                                        <th>ĐVT</th>
                                        <th>Đơn giá</th>
                                        <th>Hao hụt</th>
                                        <th>Trạng thái</th>
                                        <th>Cập nhật</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in objects %}
                                        <tr>
                                            <td><strong>{{ row.code }}</strong></td>
                                            <td>
                                                {{ row.name }}
                                                {% if row.note %}
                                                    <div class="text-muted small">{{ row.note }}</div>
                                                {% endif %}
                                            </td>
                                            <td>{{ row.category }}</td>
                                            <td>{{ row.unit }}</td>
                                            <td>{{ row.unitPrice|number_format(0, '.', ',') }}</td>
                                            <td>{{ row.wastagePercent|number_format(2, '.', ',') }}%</td>
                                            <td>
                                                <span class="badge badge-{{ row.isActive ? 'success' : 'secondary' }}">
                                                    {{ row.isActive ? 'Đang dùng' : 'Ngừng dùng' }}
                                                </span>
                                            </td>
                                            <td>{{ row.updatedAt|localizeddate('medium', 'none', null, 'Asia/Ho_Chi_Minh', 'd/M/YYYY') }}</td>
                                            <td>
                                                <div class="item-actions">
                                                    <a href="{{ path('admin_construction_material_edit', {id: row.id}) }}" class="btn-sm">
                                                        <i class="fa fa-edit" aria-hidden="true"></i>
                                                    </a>
                                                    {{ include('admin/construction_material/_delete_form.html.twig', {object: row}, with_context = false) }}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
